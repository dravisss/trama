ds\": [\n                    \"e10\",\n                    \"e16\",\n                    \"e17\"\n                  ]\n                },\n                \"speakerNotesMd\": \"\",\n                \"delta\": {},\n                \"timing\": {\n                  \"durationMs\": 5000,\n                  \"advance\": \"manual\"\n                },\n                \"transition\": {}\n              }\n            ],\n            \"stage\": {\n              \"camera\": {\n                \"mode\": \"fit-map\"\n              },\n              \"visibility\": {\n                \"hidden\": [],\n                \"ghost\": [],\n                \"context\": [],\n                \"focused\": [],\n                \"emphasized\": []\n              },\n              \"emphasis\": [],\n              \"annotations\": []\n            },\n            \"transition\": {\n              \"type\": \"dissolve\",\n              \"durationMs\": 320\n            },\n            \"timing\": {\n              \"durationMs\": 5000,\n              \"advance\": \"manual\"\n            }\n          },\n          {\n            \"id\": \"scene-a-armadilha-sistemica\",\n            \"type\": \"stage\",\n            \"title\": \"A armadilha sist\u00EAmica\",\n            \"content\": {\n              \"bodyMd\": \"\",\n              \"speakerNotesMd\": \"\",\n              \"title\": \"A armadilha sist\u00EAmica\",\n              \"caption\": \"\",\n              \"altText\": \"\"\n            },\n            \"beats\": [\n              {\n                \"id\": \"beat-resolver-casos-nao-e-recuperar-o-sistema\",\n                \"type\": \"focus\",\n                \"title\": \"Resolver casos n\u00E3o \u00E9 recuperar o sistema\",\n                \"narrationMd\": \"A carteirada pode ser racional para uma urg\u00EAncia individual, mas seu efeito agregado enfraquece a arquitetura que deveria tornar o fluxo vis\u00EDvel, coorden\u00E1vel e previs\u00EDvel.\",\n                \"focus\": {\n                  \"kind\": \"loop\",\n                  \"loopId\": \"r3\"\n                },\n                \"speakerNotesMd\": \"\",\n                \"delta\": {},\n                \"timing\": {\n                  \"durationMs\": 5000,\n                  \"advance\": \"manual\"\n                },\n                \"transition\": {}\n              }\n            ],\n            \"stage\": {\n              \"camera\": {\n                \"mode\": \"fit-map\"\n              },\n              \"visibility\": {\n                \"hidden\": [],\n                \"ghost\": [],\n                \"context\": [],\n                \"focused\": [],\n                \"emphasized\": []\n              },\n              \"emphasis\": [],\n              \"annotations\": []\n            },\n            \"transition\": {\n              \"type\": \"dissolve\",\n              \"durationMs\": 320\n            },\n            \"timing\": {\n              \"durationMs\": 5000,\n              \"advance\": \"manual\"\n            }\n          }\n        ],\n        \"summary\": \"\"\n      }\n    ],\n    \"id\": \"sobrecarga-filas-presentation\",\n    \"audience\": {\n      \"type\": \"general\",\n      \"knowledge\": \"introductory\",\n      \"expectedOutcome\": \"\"\n    },\n    \"themeId\": \"matcha-editorial\",\n    \"settings\": {\n      \"autoplay\": false,\n      \"defaultBeatDurationMs\": 5000,\n      \"allowExplore\": true,\n      \"resumeAfterExplore\": true,\n      \"showChapterProgress\": true,\n      \"reducedMotion\": \"respect-system\"\n    },\n    \"source_md\": \"# Sobrecarga de Filas\\n\\nEsta apresenta\u00E7\u00E3o mostra como m\u00FAltiplas portas de entrada e a fragmenta\u00E7\u00E3o do trabalho produzem filas concorrentes. A lat\u00EAncia leva \u00E0 carteirada, que resolve casos individuais mas amplia os canais paralelos e enfraquece o fluxo formal. Em seguida, a hist\u00F3ria mostra como o mesmo atalho corr\u00F3i a efici\u00EAncia dos aceleradores.\\n\\n## Cena: A fila deixa de ser um problema isolado\\nfocus: path e01, e08, e09\\n\\n### O backlog cresce\\nfocus: node BLD\\n\\nO backlog das \u00E1reas concentra demandas que chegaram por diferentes portas e precisam disputar a mesma capacidade interna.\\n\\n### O backlog produz handoffs\\nfocus: edge e08\\n\\nQuando o backlog cresce, cada demanda atravessa mais \u00E1reas antes de encontrar uma solu\u00E7\u00E3o.\\n\\n### Handoffs viram coordena\u00E7\u00E3o\\nfocus: edge e09\\n\\nCada passagem acrescenta reuni\u00F5es, negocia\u00E7\u00F5es e idas e vindas para alinhar escopo.\\n\\n## Cena: A fragmenta\u00E7\u00E3o alonga o tempo de ciclo\\nfocus: path e09, e16, e06\\n\\n### Coordena\u00E7\u00E3o consome capacidade\\nfocus: edge e16\\n\\nO custo de coordena\u00E7\u00E3o ocupa capacidade que poderia estar executando as demandas e aumenta o tempo total de ciclo.\\n\\n### A lat\u00EAncia chega ao cliente\\nfocus: edge e06\\n\\nQuanto mais longa a espera, menor a satisfa\u00E7\u00E3o do cliente.\\n\\n## Cena: A carteirada aparece como al\u00EDvio\\nfocus: set edge:e05, edge:e17, node:CAR\\n\\n### Insatisfa\u00E7\u00E3o ativa o atalho\\nfocus: edge e05\\n\\nA insatisfa\u00E7\u00E3o cria press\u00E3o por uma solu\u00E7\u00E3o imediata e ativa a carteirada como atalho hier\u00E1rquico.\\n\\n### O atalho reduz uma espera\\nfocus: set node:CAR, node:TCD\\n\\nPara a demanda espec\u00EDfica, a carteirada pode reduzir o tempo de ciclo e produzir a sensa\u00E7\u00E3o de que o sistema voltou a responder.\\n\\n## Cena: O al\u00EDvio alimenta o problema\\nfocus: path e18, e07, e08, e09, e16, e17\\n\\n### O atalho cria canal paralelo\\nfocus: edge e18\\n\\nCada exce\u00E7\u00E3o bem-sucedida incentiva novas demandas a contornarem o fluxo formal.\\n\\n### O canal paralelo reduz visibilidade\\nfocus: edge e12\\n\\nQuando as demandas deixam de aparecer no funil, a visibilidade da fila diminui e a coordena\u00E7\u00E3o fica ainda mais dif\u00EDcil.\\n\\n### O ciclo de sobrecarga se fecha\\nfocus: loop r3\\n\\nO atalho alivia uma demanda, mas amplia os canais paralelos, aumenta os handoffs e refor\u00E7a a pr\u00F3pria necessidade de novos atalhos.\\n\\n## Cena: O acelerador tamb\u00E9m se deteriora\\nfocus: loop r4\\n\\n### A carteirada corr\u00F3i os aceleradores\\nfocus: edge e21\\n\\nAo substituir o fluxo desenhado, a carteirada reduz a efici\u00EAncia dos aceleradores que deveriam diminuir o custo de coordena\u00E7\u00E3o.\\n\\n### A deteriora\u00E7\u00E3o alonga novamente o ciclo\\nfocus: path e10, e16, e17\\n\\nCom aceleradores menos eficientes, a coordena\u00E7\u00E3o fica mais cara, a lat\u00EAncia aumenta e a press\u00E3o pelo atalho retorna.\\n\\n## Cena: A armadilha sist\u00EAmica\\nfocus: set node:BLD, node:CAR, node:TCD, node:ACE\\n\\n### Resolver casos n\u00E3o \u00E9 recuperar o sistema\\nfocus: loop r3\\n\\nA carteirada pode ser racional para uma urg\u00EAncia individual, mas seu efeito agregado enfraquece a arquitetura que deveria tornar o fluxo vis\u00EDvel, coorden\u00E1vel e previs\u00EDvel.\\n\"\n  }\n}\n", "import publicExample from \"../../seeds/sobrecarga-filas.public.json\" with { type: \"json\" };\n\n// The public catalog deliberately contains one anonymous, self-contained map\n// and its canonical Presentation V2. User databases remain local and ignored.\nexport const examples = [publicExample];\n", "/**\n * Shared camera intent and target resolution for the presentation players.\n *\n * Camera intent is presentation state. It must be resolved from the compiled\n * frame, so editor preview and standalone playback make the same composition\n * decision.\n */\n\nimport { clampFitPadding, fitViewportToRect } from \"../geometry/fitViewport.js\";\n\nexport const CAMERA_MODES = new Set([\n  \"fit-map\",\n  \"fit-focus\",\n  \"fit-set\",\n  \"fixed\",\n  \"follow-path\",\n  \"split\"\n]);\n\n// Presentation focus needs to privilege legibility over overview. The map\n// remains available through the globe control, while focused beats can use\n