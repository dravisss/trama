# Copy to trama.env next to docker-compose.yml.
TRAMA_PUBLIC_URL=https://trama.example.org
TRAMA_PRODUCT_NAME=Trama
# Shown on the landing page for abuse reports / takedown requests (optional).
TRAMA_CONTACT=

# Behind a reverse proxy, trust its client IP header. Behind Cloudflare use
# cf-connecting-ip (Cloudflare overwrites it; X-Forwarded-For can be spoofed).
TRAMA_TRUST_PROXY=1
TRAMA_CLIENT_IP_HEADER=cf-connecting-ip

# Limits (defaults shown).
# TRAMA_MAX_JSON_BYTES=4194304
# TRAMA_MAX_ASSET_BYTES=8388608
# TRAMA_MAX_WORKSPACE_BYTES=67108864
# TRAMA_MAX_MAPS=200
# TRAMA_MAX_PRESENTATIONS=200
# TRAMA_VERSION_RETENTION=40
# Per client IP on dynamic endpoints (static files are not counted).
# TRAMA_RATE_READ=1200
# TRAMA_RATE_WRITE=600
# TRAMA_RATE_CREATE=120

# Retention: remove workspaces unopened for N days, or never edited after M days.
# TRAMA_RETENTION_DAYS=365
# TRAMA_UNTOUCHED_DAYS=14
